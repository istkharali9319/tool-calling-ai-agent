# Copy to .env and fill in. Never commit .env.

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=60
# Retries for connection errors, 408, 409, 429 and 5xx (exponential backoff, done by the SDK)
OPENAI_MAX_RETRIES=3
OPENAI_MAX_OUTPUT_TOKENS=4096
# Max model <-> tool round trips per message
MAX_TOOL_ITERATIONS=6

# --- Weather (Open-Meteo, free, no API key) ---
WEATHER_TEMPERATURE_UNIT=celsius
WEATHER_TIMEOUT_SECONDS=10
# Cache results per place for this many seconds (0 = no cache)
WEATHER_CACHE_SECONDS=600

# --- Database ---
# SQLite for local development:
DATABASE_URL=sqlite:///./assistant.db
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/assistant
SEED_ON_STARTUP=true
SQL_ECHO=false

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=UTC
HISTORY_LIMIT=20
# Comma-separated, e.g. http://localhost:3000,https://app.example.com
CORS_ORIGINS=
